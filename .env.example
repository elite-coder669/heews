APP_MODE=LIVE
PORT=8080
OPEN_METEO_BASE=https://api.open-meteo.com/v1/forecast
# Which city's ward boundaries + weather feed to run HEEWS for.
# Options: ahmedabad, bangalore, bhopal, bhubaneswar, bodh_gaya, chandigarh,
# chennai, coimbatore, delhi, faridabad, hyderabad, jaipur, kanpur, katihar,
# kishangarh, kochi, kolkata, lucknow, mumbai, nmmc, pcmc, pune, purnia,
# vadodara, vijayawada. See backend/internal/config/cities.go for details.
CITY=hyderabad
DB_URL=postgresql://heatwave:heatwave@localhost:5432/heatwave
# LLM provider: "mock" (deterministic only) or "openrouter"
AGENT_LLM_PROVIDER=openrouter
# Grab a key from https://openrouter.ai/keys and paste it here (or use a local .env)
OPENROUTER_API_KEY=sk-or-v1-YOUR_OPENROUTER_KEY_HERE
LLM_MODEL=nvidia/nemotron-3.5-lightning:free
LOG_LEVEL=info
AUTO_RUN=false
PIPELINE_INTERVAL=15m